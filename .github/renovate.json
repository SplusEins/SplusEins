{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prHourlyLimitNone",
    ":separateMajorReleases",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "branch",
  "automergeSchedule": ["* * * * 6"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "labels": ["dependencies"],
  "ignorePaths": ["app/**"],
  "packageRules": [
    {
      "description": "Everything else, monthly",
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"]
    },
    {
      "description": "Runtime and build tools, every three months",
      "groupName": "toolchain",
      "extends": ["schedule:quarterly"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchPackageNames": ["node", "@types/node", "typescript"]
    },
    {
      "groupName": "toolchain",
      "extends": ["schedule:quarterly"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchManagers": ["github-actions", "devcontainer"]
    },
    {
      "description": "Break most often, so apart from everything else",
      "groupName": "linters",
      "extends": ["packages:linters", "schedule:quarterly"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchPackageNames": ["globals"]
    },
    {
      "groupName": "test packages",
      "extends": ["packages:test", "schedule:quarterly"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"]
    },
    {
      "description": "Majors get a PR each, so closing one keeps that major away. Monorepos still come together.",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Production code and its runtime wait for a human",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["node", "@types/node"],
      "automerge": false
    }
  ],
  "schedule": ["* 0-13 1 * *"],
  "timezone": "Europe/Berlin",
  "npm": {
    "extends": [":pinAllExceptPeerDependencies"]
  }
}
