{
  "name": "spluseins-api",
  "version": "1.0.0",
  "description": "Spluseins API",
  "author": "schneefux",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "lint": "eslint --max-warnings 0 .",
    "lintfix": "eslint --fix ."
  },
  "dependencies": {
    "@motis-project/motis-fptf-client": "6.7.1",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "csv-string": "4.1.1",
    "dayjs": "1.11.23",
    "express": "5.3.0",
    "ical-generator": "10.2.0",
    "iconv-lite": "0.7.3",
    "rss": "1.2.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/rss": "0.0.32",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
