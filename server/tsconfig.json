{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    // TODO remove these
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false
  },
  "exclude": ["node_modules", "dist", "tests"]
}
